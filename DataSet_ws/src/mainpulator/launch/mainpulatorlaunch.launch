<launch>
    <arg name="control_type" default="torque" />
    <arg name="torque_home_duration" default="5.0" />
    <arg name="runtime_motion_duration" default="5.0" />
    <arg name="latency_trace_enabled" default="false" />
    <arg name="latency_trace_path" default="/tmp/test_node_latency_trace.csv" />

    <node pkg="mainpulator" type="test_node" name="test_node" output="screen" >
        <param name="control_type" type="string" value="$(arg control_type)" />
        <param name="torque_home_duration" type="double" value="$(arg torque_home_duration)" />
        <param name="runtime_motion_duration" type="double" value="$(arg runtime_motion_duration)" />
        <param name="latency_trace_enabled" type="bool" value="$(arg latency_trace_enabled)" />
        <param name="latency_trace_path" type="string" value="$(arg latency_trace_path)" />
    </node>
</launch>
