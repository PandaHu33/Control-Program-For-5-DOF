{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/protocol/canonical_goal.schema.json",
  "title": "WA100 Six-DOF Canonical Goal",
  "type": "object",
  "required": ["type", "schema_version", "seq", "source_time_ns", "receive_utc_ns", "condition_id", "wrist_source", "hand_source", "adapter_wrist_delta", "wrist_pose_C", "hand_position_units", "hand_skeleton_C", "validity", "calibrations", "invalid_reasons", "final_targets", "raw_intent", "planning"],
  "properties": {
    "type": {"const": "canonical_goal"},
    "schema_version": {"const": 4},
    "seq": {"type": "integer", "minimum": 1},
    "source_time_ns": {"type": "integer", "minimum": 0},
    "receive_utc_ns": {"type": "integer", "minimum": 0},
    "condition_id": {"type": "string"},
    "wrist_source": {"enum": ["keyboard", "gamepad", "pico_wrist", "vr_controller"]},
    "hand_source": {"enum": ["pico_hand", "data_glove", "preset_hand"]},
    "adapter_wrist_delta": {"$ref": "#/$defs/vector6"},
    "wrist_pose_C": {"$ref": "#/$defs/wristPose"},
    "hand_position_units": {"$ref": "#/$defs/handUnits"},
    "hand_skeleton_C": {"$ref": "#/$defs/handSkeleton"},
    "hand_channel_names": {"const": ["thumb_pitch", "thumb_yaw", "index", "middle", "ring", "pinky"]},
    "validity": {
      "type": "object", "required": ["wrist_dof_mask", "hand_dof_mask"],
      "properties": {
        "wrist_dof_mask": {"type": "integer", "minimum": 0, "maximum": 63},
        "hand_dof_mask": {"type": "integer", "minimum": 0, "maximum": 63}
      }
    },
    "raw_intent": {
      "type": "object", "required": ["adapter_wrist_delta", "wrist_pose_C", "arm_target_q_rad"],
      "properties": {
        "adapter_wrist_delta": {"$ref": "#/$defs/vector6"},
        "wrist_pose_C": {"$ref": "#/$defs/wristPose"},
        "arm_target_q_rad": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "planning": {"type": "object"},
    "calibrations": {
      "type": "object", "required": ["wa100_kinematics", "wa100_kinematics_sha256"],
      "properties": {
        "wa100_kinematics": {"type": "string", "minLength": 1},
        "wa100_kinematics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "invalid_reasons": {"type": "array", "items": {"type": "string"}},
    "final_targets": {
      "type": "object", "required": ["arm_target_q_rad", "hand_target_units"],
      "properties": {"hand_target_units": {"$ref": "#/$defs/handUnits"}}
    },
    "canonical_nominal": {"$ref": "#/$defs/canonicalLayer"},
    "canonical_measured": {"$ref": "#/$defs/canonicalLayer"},
    "canonical_corrected": {"$ref": "#/$defs/canonicalLayer"}
  },
  "$defs": {
    "vector6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
    "handUnits": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": 0, "maximum": 2000}},
    "wristPose": {
      "type": "object", "required": ["position_m", "orientation_xyzw"],
      "properties": {
        "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      }
    },
    "handSkeleton": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "canonicalLayer": {
      "type": "object", "required": ["timestamp_ns", "hand_position_units", "hand_skeleton_C", "validity", "calibrations"],
      "properties": {
        "timestamp_ns": {"type": "integer", "minimum": 0},
        "hand_position_units": {"oneOf": [{"$ref": "#/$defs/handUnits"}, {"type": "null"}]},
        "hand_skeleton_C": {"oneOf": [{"$ref": "#/$defs/handSkeleton"}, {"type": "null"}]},
        "validity": {"type": "object"},
        "calibrations": {"type": "object"}
      }
    }
  },
  "additionalProperties": true
}
