{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/protocol/canonical_goal.schema.json",
  "title": "E1 Canonical Goal",
  "type": "object",
  "required": [
    "type", "schema_version", "seq", "source_time_ns", "receive_utc_ns",
    "condition_id", "wrist_source", "hand_source", "adapter_wrist_delta",
    "wrist_pose_C", "hand_skeleton_w", "validity", "calibrations",
    "invalid_reasons", "final_targets"
  ],
  "properties": {
    "type": {"const": "canonical_goal"},
    "schema_version": {"const": 1},
    "seq": {"type": "integer", "minimum": 1},
    "source_time_ns": {"type": "integer", "minimum": 0},
    "receive_utc_ns": {"type": "integer", "minimum": 0},
    "condition_id": {"type": "string"},
    "publish_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "no_send": {"type": "boolean"},
    "wrist_source": {"enum": ["keyboard", "gamepad", "pico_wrist", "vr_controller"]},
    "hand_source": {"enum": ["pico_hand", "data_glove"]},
    "adapter_wrist_delta": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"type": "number"}
    },
    "wrist_pose_C": {
      "type": "object",
      "required": ["position_m", "orientation_xyzw"],
      "properties": {
        "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      }
    },
    "hand_skeleton_w": {
      "type": "array", "minItems": 21, "maxItems": 21,
      "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
    },
    "validity": {
      "type": "object", "required": ["wrist_dof_mask", "hand_node_mask"],
      "properties": {
        "wrist_dof_mask": {"type": "integer", "minimum": 0, "maximum": 63},
        "hand_node_mask": {"type": "integer", "minimum": 0, "maximum": 2097151}
      }
    },
    "calibrations": {"type": "object"},
    "invalid_reasons": {"type": "array", "items": {"type": "string"}},
    "final_targets": {"type": "object"}
  },
  "additionalProperties": true
}
